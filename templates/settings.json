{
  "uiMode": "fullscreen",
  "theme": "tokyo-night-storm-improved",
  "defaultProvider": "antigravity",
  "defaultModel": "antigravity/gemini-3.8-flash",
  "packages": [
    "npm:pi-theme-tokyo-night-storm-improved",
    "npm:pi-thinking-box",
    "npm:pi-web-access",
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-antigravity",
    "npm:pi-vcc",
    "npm:pi-subagents",
    "npm:pi-background-tasks",
    "npm:@tty-pt/pi-quest",
    "npm:@tty-pt/pi-mm"
  ],
  "subagents": {
    "agentOverrides": {
      "reviewer": {
        "thinking": false
      }
    },
    "agentOverridesByProvider": {
      "antigravity": {
        "reviewer": {
          "model": "antigravity/gemini-3.8-flash",
          "thinking": false
        }
      }
    }
  },
  "terminal": {
    "showTerminalProgress": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 5,
    "baseDelayMs": 2000,
    "provider": {
      "maxRetries": 5,
      "maxRetryDelayMs": 30000
    }
  },
  "compaction": {
    "enabled": true,
    "reserveTokens": 4096,
    "keepRecentTokens": 20000
  }
}
